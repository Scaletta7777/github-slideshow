# Токен бота от @BotFather
BOT_TOKEN=123456789:AA...

# Ключ OpenAI API: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# Ваш Telegram ID (несколько через запятую). Если оставить пустым,
# бот при первом сообщении сам покажет ваш ID.
ALLOWED_USER_IDS=

# Модель и качество генерации
OPENAI_IMAGE_MODEL=gpt-image-2
# low | medium | high  (high — лучше и дороже)
OPENAI_IMAGE_QUALITY=high

# Необязательно: путь к .ttf шрифту с кириллицей для инфографики
FONT_PATH=
